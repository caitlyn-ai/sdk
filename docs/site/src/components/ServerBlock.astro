---
// The API's server, as the OpenAPI document gives it (https://{workspace}/api), on one line: its fixed parts either
// side of its one variable, the reader's workspace hostname, as a field, so the hostname shows once. One heading,
// "Workspace" in the kicker style, is the field's label, so the input has an accessible name. What the reader types is kept in one setting the whole site shares, and every
// example on the site (the SDK reference, the guides and the API reference) shows it in place of
// your-company.caitlyn.ai (src/scripts/workspace.ts).
import { WORKSPACE_PLACEHOLDER } from '../scripts/workspace-placeholder';

interface Props {
  /** The id prefix, so two blocks on one page keep their labels apart */
  id?: string;
}
const { id = 'caitlyn-server' } = Astro.props;
---

<div class="caitlyn-server not-content" data-server>
  <!-- The box's one heading, and the field's label -->
  <label class="caitlyn-kicker caitlyn-server-head" for={`${id}-workspace`}>Workspace</label>
  <!-- The server's address once: its fixed parts as text either side of the workspace field -->
  <p class="caitlyn-server-var">
    <code class="caitlyn-server-fixed">https://</code>
    <input
      id={`${id}-workspace`}
      type="text"
      inputmode="url"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder={WORKSPACE_PLACEHOLDER}
      aria-describedby={`${id}-workspace-help`}
      data-workspace-input
    />
    <code class="caitlyn-server-fixed">/api</code>
  </p>
  <p class="caitlyn-server-help" id={`${id}-workspace-help`}>
    Your workspace's hostname. The examples on this site use it; it stays in this browser.
  </p>
</div>
