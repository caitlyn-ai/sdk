---
// The API's server, as the OpenAPI document gives it (https://{workspace}/api), with its one variable, the reader's
// workspace hostname, as a field. What the reader types is kept in one setting the whole site shares, and every
// example on the site (the SDK reference, the guides and the API reference) shows it in place of
// your-company.getcaitlyn.ai (src/scripts/workspace.ts).
import { WORKSPACE_PLACEHOLDER } from '../scripts/workspace-placeholder';

interface Props {
  /** The id prefix, so two blocks on one page keep their labels apart */
  id?: string;
}
const { id = 'caitlyn-server' } = Astro.props;
---

<div class="caitlyn-server not-content" data-server>
  <p class="caitlyn-kicker caitlyn-server-head">Server</p>
  <p class="caitlyn-server-url"><code>https://<span data-workspace-host>{WORKSPACE_PLACEHOLDER}</span>/api</code></p>
  <div class="caitlyn-server-var">
    <label for={`${id}-workspace`}><code>workspace</code></label>
    <input
      id={`${id}-workspace`}
      type="text"
      inputmode="url"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder={WORKSPACE_PLACEHOLDER}
      aria-describedby={`${id}-workspace-help`}
      data-workspace-input
    />
  </div>
  <p class="caitlyn-server-help" id={`${id}-workspace-help`}>
    Your workspace's hostname. The examples on this site use it; it stays in this browser.
  </p>
</div>
