---
// The page's right column: a reference operation's code panel (OperationPanel.astro) in place of "On this page" on
// a wide screen, and Starlight's own contents everywhere else. Below 1249px the panel moves into the page, so an
// operation page keeps Starlight's "On this page" menu there.
import Default from '@astrojs/starlight/components/PageSidebar.astro';
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import OperationPanel from './OperationPanel.astro';

const data = Astro.locals.starlightRoute.entry.data as { operation?: { kind?: 'sdk' | 'api'; panel?: Parameters<typeof OperationPanel>[0]['panel']; responses?: Parameters<typeof OperationPanel>[0]['responses']; returns?: Record<string, string>; errorClasses?: Record<string, Record<string, string>> } };
const panel = data.operation?.panel;
const kind = data.operation?.kind ?? 'sdk';
---

{
  panel?.length ? (
    <>
      <div class="lg:sl-hidden">
        <MobileTableOfContents />
      </div>
      <OperationPanel panel={panel} responses={data.operation?.responses} returns={data.operation?.returns} errorClasses={data.operation?.errorClasses} kind={kind} />
    </>
  ) : (
    <Default />
  )
}

{
  panel?.length ? (
    <script>
      import '../scripts/operation-panel.ts';
    </script>
  ) : null
}
