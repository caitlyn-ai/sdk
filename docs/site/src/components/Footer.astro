---
// The end of every page: what to read next, "Was this page useful?", then previous and next (Starlight's
// footer renders Pagination). Then the place the Caitlyn widget will go, and the language-tab script.
import Default from '@astrojs/starlight/components/Footer.astro';
import WhatsNext from './WhatsNext.astro';
import Feedback from './Feedback.astro';
import CaitlynWidgetPlaceholder from './CaitlynWidgetPlaceholder.astro';

// The landing page ends with its own content: no feedback, previous or next there
const landing = Boolean(Astro.locals.starlightRoute.entry.data.hero);
---

<WhatsNext />
{!landing && <Feedback />}
{!landing && <Default><slot /></Default>}
<CaitlynWidgetPlaceholder />

<script>
  import '../scripts/lang-tabs.ts';
  import '../scripts/sidebar-cut.ts';
</script>
