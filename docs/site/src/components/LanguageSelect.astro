---
// The code language, as a menu in a reference operation's code panel: the whole pill, styled as the language tabs'
// selected tab (the language's logo and name on the amber fill), is a button that opens a list of the languages, each
// with its logo and the chosen one marked with an ink check. A listbox in the top layer (src/scripts/language-select.ts):
// arrow keys, Home and End move, Enter or Space chooses, Escape or a click elsewhere closes and focus returns to the
// button. Every tab group on the site and every menu follow the one stored choice (src/scripts/lang-tabs.ts); a menu
// without curl shows TypeScript for it. The pill's name and logo follow the site's language before any script runs.
export const LANGUAGES = [
  { value: 'typescript', label: 'TypeScript' },
  { value: 'python', label: 'Python' },
  { value: 'go', label: 'Go' },
  { value: 'rust', label: 'Rust' },
];
export const CURL = { value: 'curl', label: 'curl' };
/** The CLI's command line, offered last on both references' operation pages */
export const CLI = { value: 'cli', label: 'CLI' };
interface Props {
  /** The API reference's menu offers curl first */
  curl?: boolean;
  /** The menu offers the CLI last: the panel has a CLI command for its examples */
  cli?: boolean;
}
const options = [...(Astro.props.curl ? [CURL] : []), ...LANGUAGES, ...(Astro.props.cli ? [CLI] : [])];
const id = `caitlyn-lang-${Astro.props.curl ? 'api' : 'sdk'}`;
---

<caitlyn-language-select data-curl={Astro.props.curl ? '' : undefined}>
  <button type="button" class="caitlyn-lang-picker" id={`${id}-button`} aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-list`}>
    <span class="sr-only">Code language: </span>
    <span class="caitlyn-lang-picker-icon" aria-hidden="true"></span>
    <span class="caitlyn-lang-picker-value">
      {options.map((l) => <span data-lang-only={l.value}>{l.label}</span>)}
    </span>
    <svg class="caitlyn-lang-picker-caret" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 15.4 6.6 10l1.4-1.4 4 4 4-4 1.4 1.4z" /></svg>
  </button>
  <ul class="caitlyn-lang-list" id={`${id}-list`} role="listbox" aria-label="Code language" tabindex="-1" popover="auto">
    {
      options.map((l) => (
        <li class="caitlyn-lang-option" id={`${id}-${l.value}`} role="option" data-value={l.value} aria-selected={l.value === 'typescript' ? 'true' : 'false'}>
          <span class="caitlyn-lang-option-icon" aria-hidden="true" />
          <span class="caitlyn-lang-option-label">{l.label}</span>
          <span class="caitlyn-lang-option-check" aria-hidden="true" />
        </li>
      ))
    }
  </ul>
</caitlyn-language-select>
