---
// The landing page's hero: the design system's Edge cover archetype on `cover-ground`. The approved field orb
// enters from the right edge, cropped by it; the title and tagline hang from the left margin. Distinct from
// caitlyn.ai's home page (a centred Horizon on white) and from the app's built-in docs (a pattern panel beside the title).
// The orb is the design system's `orb-field.png`, scaled only (src/assets/orb-field.png); Astro serves it as WebP.
// Under it, the four places most readers start (the landing page's entry in src/whats-next.json), as the same cards
// as "What's next".
import { Image } from 'astro:assets';
import orb from '../assets/orb-field.png';
import NextCards from './NextCards.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const band = (data as { whatsNext?: { link: string; title: string; description: string; section: string; icon: string }[] }).whatsNext ?? [];
---

<section class="caitlyn-hero" aria-labelledby="_top">
  <div class="caitlyn-hero-orb" aria-hidden="true">
    <Image src={orb} alt="" width={900} loading="eager" fetchpriority="high" />
  </div>
  <div class="caitlyn-hero-copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="caitlyn-hero-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="caitlyn-hero-actions">
          {actions.map(({ link, text, variant }: { link: string; text: string; variant?: string }) => (
            <a href={link} class:list={['caitlyn-hero-action', variant === 'primary' ? 'primary' : 'secondary']}>
              {text}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
{
  band.length > 0 && (
    <nav class="caitlyn-start-band" aria-labelledby="start-heading">
      <h2 id="start-heading" class="caitlyn-kicker">Most readers start with</h2>
      <NextCards cards={band} label="Places to start" />
    </nav>
  )
}
