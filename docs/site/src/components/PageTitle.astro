---
// The page header: a kicker naming where the page sits (Start here, Guide, SDK reference, API reference, Type, Error
// code), then the title at cover-title, with an operation's or SDK helper's name under it (CreateDocument). The page's first paragraph follows as its lead, and a strong rule closes the
// opening (src/styles/components.css). A guide's sections are steps, so only a guide numbers them (data-steps). The API
// reference's overview has its Workspace box under the header, and sends Scalar's old addresses (/api/#tag/...) on to
// the operation's own page before the page paints.
import OperationHeader from './OperationHeader.astro';
import ServerBlock from './ServerBlock.astro';
const data = Astro.locals.starlightRoute.entry.data as {
  title: string;
  subtitle?: string;
  section?: string;
  pageType?: string;
  server?: boolean;
  apiAnchors?: Record<string, string>;
  operation?: Parameters<typeof OperationHeader>[0]['operation'];
  channel?: { text: string; link: string; title: string };
};
// The release channel's label beside the title: an operation's, or a page's own (scripts/docs-releases.mjs)
const channel = (data.operation as { channel?: { text: string; link: string; title: string } } | undefined)?.channel ?? data.channel;
// An operation's stability, as a badge beside its name (scripts/docs-reference.mjs STABILITY has the same words). A
// generally available operation has none: the badge marks what may still change. Its release channel is a separate
// label, the Beta label (scripts/docs-releases.mjs), beside it when no stable release has the operation.
const STABILITY: Record<string, { badge: string; text: string }> = {
  preview: { badge: 'Preview', text: 'Public, and may still change before it is generally available' },
  experimental: { badge: 'Experimental', text: 'In the SDK betas only, and may change or go before it is a preview' },
  internal: { badge: 'Internal', text: 'For Caitlyn itself; not in the public SDKs' },
};
const steps = data.pageType === 'guide';
// The reference's operation, type and error-code pages: a title at the size of an operation heading
const reference = data.pageType === 'reference' || data.pageType === 'error' || data.pageType === 'sdk';
---

{
  data.apiAnchors && (
    <script is:inline define:vars={{ anchors: data.apiAnchors }}>
      // An operation's old address goes to its page; a group's to its list on this page. On arrival, and when only the
      // fragment changes (a link to an old address on this page)
      const go = () => {
        const id = decodeURIComponent(location.hash.slice(1)).replace(/^api-1\//, '').replace(/\/$/, '');
        const group = /^tag\/([a-z-]+)$/.exec(id);
        if (anchors[id]) location.replace(anchors[id]);
        else if (group) location.replace(`#${group[1]}`);
      };
      go();
      addEventListener('hashchange', go);
    </script>
  )
}
<header class="caitlyn-page-header" data-steps={steps ? '' : undefined} data-reference={reference ? '' : undefined}>
  {data.section && <p class="caitlyn-kicker caitlyn-page-section">{data.section}</p>}
  <h1 id="_top">{data.title}</h1>
  {
    data.subtitle && (
      <p class="caitlyn-page-subtitle">
        <code>{data.subtitle}</code>
        {data.operation?.stability && STABILITY[data.operation.stability] && (
          <span class="caitlyn-stability" data-stability={data.operation.stability} title={STABILITY[data.operation.stability].text}>
            {STABILITY[data.operation.stability].badge}
          </span>
        )}
        {channel && (
          <a class="caitlyn-channel" href={channel.link} title={channel.title}>
            {channel.text}
          </a>
        )}
      </p>
    )
  }
  {data.operation && <OperationHeader operation={data.operation} />}
</header>
{data.server && <div class="caitlyn-page-server"><ServerBlock id="caitlyn-page-server" /></div>}
