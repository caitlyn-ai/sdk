---
// An operation's header strip, under its title: the call in the reader's code language (the site's language picker
// chooses it, src/scripts/lang-tabs.ts), the HTTP call, and the same operation in the other reference. The SDK
// reference leads with the SDK call; the API reference leads with the HTTP call. scripts/docs-build.mjs writes the
// data (scripts/docs-reference.mjs, scripts/docs-api.mjs).
interface Props {
  operation: { kind?: 'sdk' | 'api'; name: string; method: string; calls: Record<string, string>; http: { method: string; path: string }; other: { label: string; link: string } };
}
const { operation } = Astro.props;
const LABELS: Record<string, string> = { typescript: 'TypeScript', python: 'Python', go: 'Go', rust: 'Rust' };
const api = operation.kind === 'api';
---

<dl class="caitlyn-operation-strip">
  <!-- Each call is a chip: cut in the middle when it does not fit (its start and end kept), its whole value on hover
       and focus when cut, and copied on click (src/scripts/chip-fit.ts) -->
  {
    api && (
      <div class="caitlyn-operation-strip-row">
        <dt class="caitlyn-kicker">HTTP</dt>
        <dd>
          <button type="button" class="caitlyn-chip" data-chip={`${operation.http.method} ${operation.http.path}`} aria-label={`Copy ${operation.http.method} ${operation.http.path}`}>
            <code class="caitlyn-strip-code"><span class="caitlyn-http-method" data-method={operation.http.method}>{operation.http.method}</span> <span class="caitlyn-chip-text">{operation.http.path}</span></code>
          </button>
        </dd>
      </div>
    )
  }
  <div class="caitlyn-operation-strip-row">
    <dt class="caitlyn-kicker">SDK</dt>
    <dd>
      {
        Object.entries(operation.calls).map(([lang, call]) => (
          <span data-lang-only={lang}>
            <span class="sr-only">{LABELS[lang]}: </span>
            <button type="button" class="caitlyn-chip" data-chip={call} aria-label={`Copy the ${LABELS[lang]} call: ${call}`}>
              <code class="caitlyn-strip-code"><span class="caitlyn-chip-text">{call}</span></code>
            </button>
          </span>
        ))
      }
    </dd>
  </div>
  {
    !api && (
      <div class="caitlyn-operation-strip-row">
        <dt class="caitlyn-kicker">HTTP</dt>
        <dd>
          <button type="button" class="caitlyn-chip" data-chip={`${operation.http.method} ${operation.http.path}`} aria-label={`Copy ${operation.http.method} ${operation.http.path}`}>
            <code class="caitlyn-strip-code"><span class="caitlyn-http-method" data-method={operation.http.method}>{operation.http.method}</span> <span class="caitlyn-chip-text">{operation.http.path}</span></code>
          </button>
        </dd>
      </div>
    )
  }
  <div class="caitlyn-operation-strip-row caitlyn-operation-strip-api">
    <dd><a href={operation.other.link}>{operation.other.label}</a></dd>
  </div>
</dl>

<script>
  import '../scripts/chip-fit.ts';
</script>
