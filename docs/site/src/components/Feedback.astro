---
// "Was this page useful?" The answer is the page's path and yes or no, nothing else: no free text, no cookie,
// no identifier. It is shown only when the build sets PUBLIC_DOCS_FEEDBACK=on, and sent only when it also sets
// PUBLIC_DOCS_FEEDBACK_ENDPOINT (the live build: /_feedback, production-demo-infrastructure developer-docs/
// feedback.tf); without an endpoint it says so instead of pretending.
// The thumbs icons are Lucide's thumbs-up and thumbs-down (ISC licence), inline.
// The browser remembers the answer for the page in localStorage, so a second click sends nothing.
const enabled = import.meta.env.PUBLIC_DOCS_FEEDBACK === 'on';
const endpoint = import.meta.env.PUBLIC_DOCS_FEEDBACK_ENDPOINT ?? '';
---

{
  enabled && (
    <section class="caitlyn-feedback print:hidden" data-feedback data-endpoint={endpoint} aria-labelledby="feedback-heading">
      <div class="copy">
        <p id="feedback-heading" class="question">Was this page useful?</p>
        <p class="note">Your answer goes to the docs team. No personal data is captured.</p>
      </div>
      <div class="answers" role="group" aria-labelledby="feedback-heading">
        <button type="button" data-answer="yes">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12" /><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z" /></svg>
          Helpful
        </button>
        <button type="button" data-answer="no">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 14V2" /><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z" /></svg>
          Needs work
        </button>
      </div>
      <p class="status" role="status" aria-live="polite"></p>
    </section>
  )
}

<script>
  const KEY = 'caitlyn-docs-feedback:';
  for (const box of document.querySelectorAll<HTMLElement>('[data-feedback]')) {
    const status = box.querySelector<HTMLElement>('.status')!;
    const buttons = [...box.querySelectorAll<HTMLButtonElement>('button[data-answer]')];
    const page = location.pathname;
    const done = (answer: string, note: string) => {
      for (const b of buttons) {
        b.disabled = true;
        b.setAttribute('aria-pressed', String(b.dataset.answer === answer));
      }
      status.textContent = note;
    };
    let previous: string | null = null;
    try {
      previous = localStorage.getItem(KEY + page);
    } catch {
      // storage blocked: every visit can answer once
    }
    if (previous) done(previous, 'Thanks for your answer.');
    for (const button of buttons) {
      button.addEventListener('click', async () => {
        const answer = button.dataset.answer!;
        const endpoint = box.dataset.endpoint;
        try {
          localStorage.setItem(KEY + page, answer);
        } catch {
          // fine: the answer is still sent once
        }
        if (!endpoint) return done(answer, 'Thanks. Answers are not being collected yet, so this one was not sent.');
        try {
          // The endpoint is a Lambda function URL behind CloudFront Origin Access Control, which needs the body's
          // SHA-256 in x-amz-content-sha256 on a POST (Lambda accepts no unsigned payload).
          const body = JSON.stringify({ page, answer });
          const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(body));
          const hash = [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-amz-content-sha256': hash },
            body,
            keepalive: true,
          });
          done(answer, response.ok ? 'Thanks for your answer.' : 'Thanks. Your answer could not be sent.');
        } catch {
          done(answer, 'Thanks. Your answer could not be sent.');
        }
      });
    }
  }
</script>
