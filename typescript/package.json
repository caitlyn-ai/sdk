{
  "name": "caitlyn-sdk-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk-core",
    "packages/sdk"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "conformance": "node scripts/build-conformance.mjs && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../build/conformance/typescript.xml dist/conformance.test.mjs",
    "test:runtime": "node scripts/build-conformance.mjs && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../build/conformance/typescript-runtime.xml dist/auth.test.mjs dist/waiter.test.mjs",
    "build": "node scripts/build-packages.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@tsconfig/node20": "20.1.8",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
