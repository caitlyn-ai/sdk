{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "../packages/sdk-core/src",
    "declarationDir": "../packages/sdk-core/dist-types"
  },
  "include": ["../packages/sdk-core/src"]
}
