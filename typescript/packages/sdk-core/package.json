{
  "name": "@caitlyn-ai/sdk-core",
  "version": "0.5.0",
  "description": "The runtime core of the Caitlyn TypeScript SDK: the Caitlyn REST JSON protocol, sign-in, retries, server-sent events, waiters and telemetry.",
  "license": "Apache-2.0",
  "homepage": "https://build.caitlyn.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caitlyn-ai/sdk.git",
    "directory": "typescript/packages/sdk-core"
  },
  "sideEffects": false,
  "main": "./dist-cjs/index.cjs",
  "module": "./dist-es/index.mjs",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "workerd": "./dist-es/index.mjs",
      "worker": "./dist-es/index.mjs",
      "deno": "./dist-es/index.mjs",
      "edge-light": "./dist-es/index.mjs",
      "browser": "./dist-browser/index.mjs",
      "import": "./dist-es/index.mjs",
      "require": "./dist-cjs/index.cjs"
    },
    "./browser": {
      "types": "./dist-types/index.d.ts",
      "default": "./dist-browser/index.mjs"
    },
    "./smithy": {
      "workerd": "./dist-es/smithy.mjs",
      "worker": "./dist-es/smithy.mjs",
      "deno": "./dist-es/smithy.mjs",
      "edge-light": "./dist-es/smithy.mjs",
      "browser": "./dist-browser/smithy.mjs",
      "import": "./dist-es/smithy.mjs",
      "require": "./dist-cjs/smithy.cjs"
    },
    "./browser/smithy": {
      "default": "./dist-browser/smithy.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-*/**",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@smithy/core": "^3.39.0",
    "@smithy/types": "^4.20.0",
    "@opentelemetry/api": "^1.9.0"
  }
}
