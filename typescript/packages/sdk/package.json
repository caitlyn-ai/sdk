{
    "name": "@caitlyn-ai/sdk",
    "description": "The TypeScript SDK for the Caitlyn v3 API.",
    "version": "0.6.0",
    "license": "Apache-2.0",
    "homepage": "https://build.caitlyn.ai",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/caitlyn-ai/sdk.git",
        "directory": "typescript/packages/sdk"
    },
    "sideEffects": false,
    "main": "./dist-cjs/sdk/index.cjs",
    "module": "./dist-es/sdk/index.mjs",
    "types": "./dist-types/sdk/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist-types/sdk/index.d.ts",
            "workerd": "./dist-edge/sdk/index.mjs",
            "worker": "./dist-edge/sdk/index.mjs",
            "deno": "./dist-edge/sdk/index.mjs",
            "edge-light": "./dist-edge/sdk/index.mjs",
            "browser": "./dist-browser/sdk/index.mjs",
            "import": "./dist-es/sdk/index.mjs",
            "require": "./dist-cjs/sdk/index.cjs"
        },
        "./browser": {
            "types": "./dist-types/sdk/index.d.ts",
            "default": "./dist-browser/sdk/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist-*/**",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "tslib": "^2.6.2",
        "@caitlyn-ai/sdk-core": "0.6.0",
        "@smithy/core": "^3.37.0",
        "@smithy/fetch-http-handler": "^5.8.0",
        "@smithy/types": "^4.19.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
